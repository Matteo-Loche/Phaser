# Generated PHREEQC databases and the sidecars written by POST /api/databases/register:
# keep the example metadata only
data/databases/generated/*.dat
data/databases/generated/*.meta.json
!data/databases/generated/.gitkeep
!data/databases/generated/example.meta.json

# SQLite PHREEQC catalog cache (regenerated from PHREEQC on startup)
data/catalog.sqlite
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal

# IPhreeqc scratch dumps written to the working directory on error/dump
error.inp
phreeqc.out
dump.out
error.out
selected.out
phreeqc.log

